{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mimesis/flames.schema.json",
  "title": "mimesis.flames.v1",
  "description": "Bright-blob analysis for one panel: candle flames, ceiling fixtures, and the distance from each flame to the nearest detected face. Answers the brief's question about a candle with no face to attach it to. Coordinates normalised to the rectified painting rectangle. Produced by stage1/detect_flames.py.",
  "type": "object",
  "required": [
    "schema",
    "panel",
    "parameters",
    "counts",
    "blobs"
  ],
  "properties": {
    "schema": {
      "const": "mimesis.flames.v1"
    },
    "panel": {
      "enum": [
        "A",
        "B"
      ]
    },
    "painting_rect_px": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "parameters": {
      "description": "Every threshold used, echoed into the output so the classification can be argued with rather than taken on faith.",
      "type": "object",
      "required": [
        "v_percentile",
        "value_threshold",
        "kind_rule",
        "orphan_threshold_face_heights"
      ],
      "properties": {
        "v_percentile": {
          "type": "number"
        },
        "value_threshold": {
          "type": "number"
        },
        "min_area_frac": {
          "type": "number"
        },
        "max_area_frac": {
          "type": "number"
        },
        "warm_hue_range": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "orphan_threshold_face_heights": {
          "type": "number"
        },
        "kind_rule": {
          "type": "string"
        },
        "faces_counted": {
          "enum": [
            "consensus",
            "all"
          ],
          "description": "Which detections counted as a face for the orphan test. 'consensus' means only faces both detectors found. At a permissive threshold the single-detector boxes sit near the noise floor, and counting them means every candle lands near some box and nothing is ever reported unattached -- the test defeats itself."
        },
        "faces_available": {
          "type": "integer"
        },
        "faces_used": {
          "type": "integer"
        }
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "blobs": {
          "type": "integer"
        },
        "flames": {
          "type": "integer"
        },
        "ceiling_fixtures": {
          "type": "integer"
        },
        "bright_other": {
          "type": "integer"
        },
        "flames_unattached": {
          "type": "integer"
        }
      }
    },
    "blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "blob_id",
          "kind",
          "centroid",
          "box",
          "area_frac"
        ],
        "properties": {
          "blob_id": {
            "type": "string",
            "pattern": "^[AB]F[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "flame",
              "ceiling_fixture",
              "bright_other"
            ]
          },
          "centroid": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "area_frac": {
            "type": "number"
          },
          "aspect_h_over_w": {
            "type": "number"
          },
          "median_hue": {
            "type": "number"
          },
          "median_sat": {
            "type": "number"
          },
          "mean_value": {
            "type": "number"
          },
          "surround_mean_value": {
            "type": "number"
          },
          "nearest_face": {
            "type": [
              "object",
              "null"
            ],
            "description": "null for non-flame blobs, or when the panel has no detected faces at all.",
            "required": [
              "face_id",
              "distance_in_face_heights",
              "unattached"
            ],
            "properties": {
              "face_id": {
                "type": "string"
              },
              "distance_in_face_heights": {
                "type": "number",
                "description": "Euclidean distance from flame centroid to face box centre, divided by that face's box height. Scale-free, so it is comparable across panels of different composition."
              },
              "unattached": {
                "type": "boolean",
                "description": "distance_in_face_heights > parameters.orphan_threshold_face_heights. A threshold, not a verdict; move it and re-derive."
              }
            }
          }
        }
      }
    }
  }
}
