{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mimesis/reconcile.schema.json",
  "title": "mimesis.reconcile.v1",
  "description": "The three-way count table the brief asks for, per panel: what the detector found, what each model claimed, and the true number. Disagreement is preserved and reported, never reconciled away. Produced by stage1/reconcile.py.",
  "type": "object",
  "required": ["schema", "panels"],
  "properties": {
    "schema": { "const": "mimesis.reconcile.v1" },
    "panels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["detector", "models", "truth"],
        "properties": {
          "detector": {
            "type": "object",
            "properties": {
              "merged": { "type": "integer", "description": "Faces after merging both detectors." },
              "both_detectors_agree": { "type": "integer" },
              "blazeface_only": { "type": "integer" },
              "yunet_only": { "type": "integer" },
              "mesh_converged": { "type": "integer" },
              "max_confidence": { "type": "number" },
              "median_confidence": { "type": "number" }
            }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "session_id": { "type": "string" },
                "model": { "type": "string" },
                "stated": { "type": ["integer", "null"] },
                "hedged": { "type": "boolean" },
                "delta_vs_truth": { "type": ["integer", "null"] },
                "delta_vs_detector": { "type": ["integer", "null"] }
              }
            }
          },
          "truth": {
            "type": "object",
            "required": ["value", "basis"],
            "properties": {
              "value": { "type": ["integer", "null"] },
              "basis": {
                "type": "string",
                "description": "How the true number is known. For Panel A this is the artist's knowledge of the source photograph. For Panel B, state plainly what 'true' even means when nobody was in the room -- e.g. 'figures depicted', with the count supplied by the artist. Never inferred by this pipeline."
              }
            }
          },
          "unattached_flames": { "type": "integer" },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
